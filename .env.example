# Discord Developer Portal > OAuth2 > Client ID and Client Secret
AUTH_DISCORD_ID=1554302952280301660
AUTH_DISCORD_SECRET=

# Generate a random secret, for example with: openssl rand -base64 32
AUTH_SECRET=

# Enable Developer Mode in Discord, then copy the server and access-role IDs
DISCORD_GUILD_ID=1550623259853193276
DISCORD_REQUIRED_ROLE_ID=1554289450480304268

# Shown to visitors who have not joined the server
DISCORD_INVITE_URL=https://discord.gg/N8c5m2QA8A

# Register this OAuth2 redirect URI in the Discord Developer Portal:
# http://127.0.0.1:3100/api/auth/callback/discord (this local preview)
# http://localhost:3000/api/auth/callback/discord (default development port)
# Use https://your-domain/api/auth/callback/discord in production.

# Vercel + Railway split deployment
# Set the same random 32+ character value on Vercel and Railway.
VIDEO_API_TOKEN_SECRET=
# Set on Railway to the exact Vercel origin(s), comma-separated.
VIDEO_ALLOWED_ORIGINS=
# Set on Vercel to the Railway public service URL, without a trailing slash.
NEXT_PUBLIC_VIDEO_API_URL=
